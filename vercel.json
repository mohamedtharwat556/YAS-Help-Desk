{
  "rewrites": [
    {
      "source": "/health",
      "destination": "/api/health.js"
    },
    {
      "source": "/api/auth/login",
      "destination": "/api/auth/login.js"
    },
    {
      "source": "/api/public/submit-ticket",
      "destination": "/api/public/submit-ticket.js"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/:path*.js"
    }
  ]
}